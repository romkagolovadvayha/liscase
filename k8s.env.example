# LiSCase Kubernetes Configuration
# Скопируйте этот файл в k8s.env и заполните своими значениями

# Docker Registry
DOCKER_REGISTRY=your-registry.com
IMAGE_TAG=latest

# Kubernetes
KUBE_NAMESPACE=liscase
KUBE_CONTEXT=your-cluster-context

# Database
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_DATABASE=prostoj4
MYSQL_USER=liscase
MYSQL_PASSWORD=your-secure-password

# Redis
REDIS_PASSWORD=your-redis-password

# Application
APP_ENV=production
APP_DEBUG=false
COOKIE_VALIDATION_KEY=your-32-character-secret-key-here

# S3/Storage
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=liscase-uploads
S3_REGION=us-east-1

# External Services
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
STEAM_API_KEY=your-steam-api-key

# Domains (замените на свои)
FRONTEND_DOMAIN=prostoj.store
BACKEND_DOMAIN=e.prostoj.store
API_DOMAIN=api.prostoj.store
FRONTEND_EN_DOMAIN=en.prostoj.store
WS_DOMAIN=ws.prostoj.store

# WebSocket Backend
WS_BACKEND_HOST=127.0.0.1
WS_BACKEND_PORT=4888

# Radio Servers
RADIO1_HOST=127.0.0.1
RADIO1_PORT=3007
RADIO2_HOST=127.0.0.1
RADIO2_PORT=3008

# PHP-FPM
PHP_FPM_HOST=127.0.0.1
PHP_FPM_PORT=9000
PHP_TIMEOUT=300
UPLOAD_MAX_SIZE=128M
STATIC_CACHE_TIME=30d

