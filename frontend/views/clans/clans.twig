{{ use('kartik/grid/GridView') }}
{{ use('yii/widgets/ListView') }}
{{ use('yii/widgets/Pjax') }}
{{ use('frontend/widgets/Alert') }}
{{ use('frontend/assets/ClanApplicationsAsset') }}
{{ alert_widget() }}

{{ register_asset_bundle('frontend\\assets\\ClanApplicationsAsset') }}
<nav class="servers_navbar mb-24">
    <ul class="servers_navbar_nav">
        {% for ITEM in SERVERS %}
            <li>
                <a href="{{ ITEM.getLink('clans') }}" class="servers_navbar_nav_item{% if ITEM.tag == SERVER.tag %} active{% endif %}">
                    {{ t('database', ITEM.monitoring_name) }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
<div class="clans_raiting mb-24" style="background-image: url({{ SETTINGS.get('clans_background') }})">
    <div class="clans_raiting_list">
        {% include 'clans_item.twig'
            with {
                'ITEM': SILVER_CLAN,
                'POSITION': 2,
                'IMAGE': SETTINGS.get('clans_silver'),
                'CLASS': 'clans_raiting_list_item_silver',
            }
        %}
        {% include 'clans_item.twig'
            with {
                'ITEM': GOLD_CLAN,
                'POSITION': 1,
                'IMAGE': SETTINGS.get('clans_gold'),
                'CLASS': 'clans_raiting_list_item_gold',
            }
        %}
        {% include 'clans_item.twig'
            with {
            'ITEM': BRONZE_CLAN,
            'POSITION': 3,
            'IMAGE': SETTINGS.get('clans_bronze'),
            'CLASS': 'clans_raiting_list_item_bronze',
        }
        %}
</div>
<div class="flex justify-space-between items-center flex-wrap mb-24 mt-40">
    <h1 class="h2">{{ t('common', 'Рейтинг кланов') }}</h1>
    {% if CLAN %}
        <a href="{{ CLAN.link }}" class="button button-secondary">
            {{ t('common', 'Мой клан') }}
        </a>
    {% else %}
        <button data-href="/clans/create" data-size="modal-md" data-toggl="modal" data-target="modal-dialog" data-title="{{ t('common', 'Создать клан') }}" class="button-secondary show-modal-link">
            {{ t('common', 'Создать клан') }}
        </button>
    {% endif %}
</div>

<!-- Форма поиска -->
<div class="clans-search-form bg-background-secondary p-20 rounded-12 mb-24">
    <form method="get" class="clans-search-form-content">
        <div class="search-form-row">
            <div class="search-form-group">
                <label for="search" class="search-form-label">{{ t('common', 'Поиск') }}:</label>
                <input type="text" 
                       id="search" 
                       name="ClanSearch[search]" 
                       value="{{ SEARCH_MODEL.search|default('') }}" 
                       placeholder="{{ t('common', 'Название клана или описание...') }}"
                       class="search-form-input">
            </div>
            
            <div class="search-form-group">
                <label for="min_rating" class="search-form-label">{{ t('common', 'Рейтинг от') }}:</label>
                <input type="number" 
                       id="min_rating" 
                       name="ClanSearch[min_rating]" 
                       value="{{ SEARCH_MODEL.min_rating|default('') }}" 
                       placeholder="0"
                       class="search-form-input">
            </div>
            
            <div class="search-form-group">
                <label for="max_rating" class="search-form-label">{{ t('common', 'Рейтинг до') }}:</label>
                <input type="number" 
                       id="max_rating" 
                       name="ClanSearch[max_rating]" 
                       value="{{ SEARCH_MODEL.max_rating|default('') }}" 
                       placeholder="1000"
                       class="search-form-input">
            </div>
            
            <div class="search-form-group">
                <label for="min_members" class="search-form-label">{{ t('common', 'Участников от') }}:</label>
                <input type="number" 
                       id="min_members" 
                       name="ClanSearch[min_members]" 
                       value="{{ SEARCH_MODEL.min_members|default('') }}" 
                       placeholder="1"
                       class="search-form-input">
            </div>
            
            <div class="search-form-group">
                <label for="max_members" class="search-form-label">{{ t('common', 'Участников до') }}:</label>
                <input type="number" 
                       id="max_members" 
                       name="ClanSearch[max_members]" 
                       value="{{ SEARCH_MODEL.max_members|default('') }}" 
                       placeholder="50"
                       class="search-form-input">
            </div>
            
            <div class="search-form-actions">
                <button type="submit" class="button button-primary">
                    <i class="fas fa-search"></i> {{ t('common', 'Поиск') }}
                </button>
                <a href="{{ SERVER.getLink('clans') }}" class="button button-secondary">
                    <i class="fas fa-times"></i> {{ t('common', 'Сбросить') }}
                </a>
            </div>
        </div>
    </form>
</div>
<div>
    {{ grid_view_widget({
        'id': 'clans-list-view',
        'dataProvider': DATA_PROVIDER,
        'layout': '{items} {pager}',
        'pjax': true,
        'pjaxSettings': {
            'neverTimeout': true,
            'options': {
                'enablePushState': false,
                'enableReplaceState': false,
            },
        },
        'columns': [
            {
                'attribute': 'avatar',
                'label': '',
                'format': 'raw',
                'options': {'width': '70'},
                'value': func.avatar
            },
            {
                'attribute': 'title',
                'label': t('common', 'Название клана'),
                'format': 'raw',
                'value': func.title,
            },
            {
                'attribute': 'rating',
                'label': "<span class=\"item_param_th\"><img src=\"/images/awards/all.png\" data-bs-toggle=\"tooltip\" data-bs-title=\"#{t('database', 'Рейтинг')}\" class=\"block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover\"></span>",
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.rating,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'kills',
                'label': "<span class=\"item_param_th\"><img src=\"/images/awards/killer.png\" data-bs-toggle=\"tooltip\" data-bs-title=\"#{t('database', 'Убийств')}\" class=\"block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover\"></span>",
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.kills,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'users_count',
                'label': "<span class=\"item_param_th\" data-bs-toggle=\"tooltip\" data-bs-title=\"#{t('database', 'Человек в команде')}\"><span style=\"background: var(--text-secondary);\" class=\"icons icons_36px icons_32px_users\"></span></span>",
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.users_count,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'scrap',
                'label': "<span class=\"item_param_th\"><img src=\"/uploads/drop/305_6949c48b05801055b644b5938b1c427c.png\" data-bs-toggle=\"tooltip\" data-bs-title=\"#{t('database', 'Найденного скрапа')}\" class=\"block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover\"></span>",
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.scrap,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'sulfur.ore',
                'label': "<span class=\"item_param_th\"><img src=\"/uploads/drop/312_f1bbbd27a6a2da9e0f82b83ae1ac284a.png\" data-bs-toggle=\"tooltip\" data-bs-title=\"#{t('database', 'Нафармленной серы')}\" class=\"block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover\"></span>",
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.sulfur,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
        ]
    }) }}
</div>
</div>