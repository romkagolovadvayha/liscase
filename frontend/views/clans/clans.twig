{{ use('kartik/grid/GridView') }}
{{ use('yii/widgets/ListView') }}
{{ use('yii/widgets/Pjax') }}

<nav class="servers_navbar mb-24">
    <ul class="servers_navbar_nav">
        {% for ITEM in SERVERS %}
            <li>
                <a href="{{ ITEM.getLink('clans') }}" class="servers_navbar_nav_item{% if ITEM.tag == SERVER.tag %} active{% endif %}">
                    {{ t('database', ITEM.monitoring_name) }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
<div class="clans_raiting mb-24" style="background-image: url({{ SETTINGS.get('clans_background') }})">
    <div class="clans_raiting_list">
        {% include 'clans_item.twig'
            with {
                'ITEM': SILVER_CLAN,
                'POSITION': 2,
                'IMAGE': SETTINGS.get('clans_silver'),
                'CLASS': 'clans_raiting_list_item_silver',
            }
        %}
        {% include 'clans_item.twig'
            with {
                'ITEM': GOLD_CLAN,
                'POSITION': 1,
                'IMAGE': SETTINGS.get('clans_gold'),
                'CLASS': 'clans_raiting_list_item_gold',
            }
        %}
        {% include 'clans_item.twig'
            with {
            'ITEM': BRONZE_CLAN,
            'POSITION': 3,
            'IMAGE': SETTINGS.get('clans_bronze'),
            'CLASS': 'clans_raiting_list_item_bronze',
        }
        %}
</div>
<div class="flex justify-space-between items-center flex-wrap mb-24 mt-40">
    <h1 class="h2">{{ t('common', 'Рейтинг кланов') }}</h1>
    {% if CLAN %}
        <a href="{{ CLAN.link }}" class="button button-secondary">
            {{ t('common', 'Мой клан') }}
        </a>
    {% else %}
        <button data-href="/clans/create" data-size="modal-md" data-toggl="modal" data-target="modal-dialog" data-title="{{ t('common', 'Создать клан') }}" class="button-secondary show-modal-link">
            {{ t('common', 'Создать клан') }}
        </button>
    {% endif %}
</div>
<div>
    {{ grid_view_widget({
        'id': 'clans-list-view',
        'dataProvider': DATA_PROVIDER,
        'layout': '{items} {pager}',
        'pjax': true,
        'pjaxSettings': {
            'neverTimeout': true,
            'options': {
                'enablePushState': false,
                'enableReplaceState': false,
            },
        },
        'columns': [
            {
                'attribute': 'avatar',
                'label': '',
                'format': 'raw',
                'options': {'width': '70'},
                'value': func.avatar
            },
            {
                'attribute': 'title',
                'label': t('common', 'Название клана'),
                'format': 'raw',
                'value': func.title,
            },
            {
                'attribute': 'kills',
                'label': '<span class="item_param_th"><img src="/images/awards/killer.png" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover"></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.kills,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'users_count',
                'label': '<span class="item_param_th"><span style="background: var(--text-secondary);" class="icons icons_36px icons_32px_users"></span></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.users_count,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'rocket_basic',
                'label': '<span class="item_param_th"><img src="/uploads/drop/602_0736169c589c86cc02ce3f46ad8edfd4.png" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover"></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.rocket,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'c4thrown',
                'label': '<span class="item_param_th"><img src="/uploads/drop/446_3da715bdfd205544821f8969040465c2.png" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover"></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.c4,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'scrap',
                'label': '<span class="item_param_th"><img src="/uploads/drop/305_6949c48b05801055b644b5938b1c427c.png" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover"></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.scrap,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
            {
                'attribute': 'sulfur.ore',
                'label': '<span class="item_param_th"><img src="/uploads/drop/312_f1bbbd27a6a2da9e0f82b83ae1ac284a.png" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 object-cover"></span>',
                'format': 'raw',
                'encodeLabel': false,
                'options': {'width': '100'},
                'value': func.sulfur,
                'headerOptions': {'class': 'item_param_th_wrap'}
            },
        ]
    }) }}
</div>