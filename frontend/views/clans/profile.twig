<nav class="servers_navbar mb-24">
    <ul class="servers_navbar_nav">
        {% for ITEM in SERVERS %}
            <li>
                <a href="{{ CLAN.getLink('profile', ITEM.tag) }}" class="servers_navbar_nav_item{% if ITEM.tag == SERVER.tag %} active{% endif %}">
                    {{ t('database', ITEM.monitoring_name) }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
<section class="page-stats__block profile flex-row justify-space-between items-flex-end" style="height: 300px;background-image: url({{ CLAN.background }}); background-size: cover; background-position: center center;">
    <!-- ОНЛАЙН -->
    <div class="profile__wrapper profile_offline">
        <div class="profile__image">
            <img src="{{ CLAN.logo }}" alt="пьяный ниндзя">
        </div>
        <div>
            <h2 class="text-primary-colors-main flex items-center gap-x-12">
                {{ CLAN.title }}
            </h2>
            <p class="p1 text-text-main">{{ t('database', CLAN.description_short) }}</p>
        </div>
    </div>
    <div>
        {% if ROLES.ROLE_MEMBER %}
            <button data-href="/clans/create" data-size="modal-md" data-toggl="modal" data-target="modal-dialog" data-title="{{ t('common', 'Создать клан') }}" class="button-primary show-modal-link">
                <span class="button__text">{{ t('common', 'Покинуть клан') }}</span>
            </button>
        {% else %}
            <button data-href="/clans/create" data-size="modal-md" data-toggl="modal" data-target="modal-dialog" data-title="{{ t('common', 'Создать клан') }}" class="button-primary show-modal-link">
                <span class="button__text">{{ t('common', 'Вступить в клан') }}</span>
            </button>
        {% endif %}
    </div>
</section>

