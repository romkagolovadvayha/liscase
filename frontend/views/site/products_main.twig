<!-- ВАЙП_БЛОК -->
{% if PRODUCT_DROPS_SETS %}
<section class="sets__wrapper mobile_hide">
    <div class="sets">
        {% set i = 0 %}
        {% for item in PRODUCT_DROPS %}
            {% set is_favorite = not USER_GUEST and item.id in FAVORITE_IDS %}
            {% include 'product_main.twig'
                with {
                'URL': "/market/form-modal?id=#{item.id}",
                'PRODUCT_ID': item.id,
                'IS_FAVORITE': is_favorite,
                'PRICE': item.price,
                'PRICE_REAL': item.getRealPrice(),
                'CURRENCY': 'RUB',
                'NAME': item.name,
                'CATEGORY_ID': item.category_id,
                'IMAGE': IMAGES[item.id]['150px'],
                'IMAGE2': item.image2(),
                'COUNT': item.count,
                'BLOCKED': item.blocked(),
                'BLOCKED_AT': item.blocked_at,
                'BLOCKED_TIME': item.blockedTime(),
                'INDEX': i,
                'USER_GUEST': USER_GUEST,
            }
            %}
            {% set i = i + 1 %}
        {% endfor %}
    </div>
    <button class="button-secondary" id="more_sets">{{ t('common', 'Показать еще') }}</button>
</section>
{% endif %}