<div class="info mobile_hide">
    {% if USER_GUEST %}
    <!-- БЕЗ АВТОРИЗАЦИИ -->
    <section class="user user_not-authorized">
        <h1 class="user__title main_title">{{ t('common', 'Лучшие сервера для комфортной игры!') }}</h1>
        <p class="user__description">{{ t('common', 'Войдите в систему, чтобы начать играть') }}</p>
        <div class="user__stats stats">
            <div class="stats__item">
                <p>{{ t('common', 'Игроков') }}</p>
                <p>{{ PROJECT_STATS.users|number_format(0, '', ' ') }}</p>
            </div>
            <div class="stats__item">
                <p>{{ t('common', 'Онлайн') }}</p>
                <p>{{ PROJECT_STATS.online|number_format(0, '', ' ') }}</p>
            </div>
            <div class="stats__item">
                <p>{{ t('common', 'Серверов') }}</p>
                <p>{{ PROJECT_STATS.count|number_format(0, '', ' ') }}</p>
            </div>
        </div>
        {% if SETTINGS.get('design_statsBlockImageVideo') %}
        <video class="user__image" playsinline loop autoplay muted data-lazy="true" preload="none" poster="{{ SETTINGS.get('design_statsBlockImage') }}">
            <source type="video/webm" src="{{ SETTINGS.get('design_statsBlockImageVideo') }}">
        </video>
        {% else %}
            <img src="{{ SETTINGS.get('design_image_not_auth') }}" alt="farmer" class="user__image" loading="lazy"/>
        {% endif %}
        <div class="user__stats_footer">
            <a href="/auth/oauth?authclient=steam" rel="nofollow" class="button button-primary h-48 snow-drift snow-drift-1 snow-drift-right" style="padding-top: 15px;">
              <span class="button__text">
                {{ t('common', 'Войти через Steam') }}
                <span class="icons icons_24px icons_24px_steam bg-white"></span>
              </span>
            </a>
            <a href="/servers/{{ USER.SERVER_ACTIVE_TAG }}" class="button button-secondary" style="padding-top: 15px;">
                <span class="button__text">{{ t('common', 'Статистика игроков') }}</span>
            </a>
        </div>
    </section>
    {% else %}
        <!-- С АВТОРИЗАЦИЕЙ -->
        <section class="user">
            <h1 class="user__title">{{ USER.username }}</h1>
            {% if ACTIVE_VIP %}
            <div class="user__vip">
                <i class="fas fa-crown user__vip-icon"></i>
                <p class="user__vip-text">
                    {{ t('common', 'Осталось до окончания') }}: <span class="server_timer" data-time="{{ ACTIVE_VIP_TIMESTAMP }}">{{ ACTIVE_VIP.expires_at }}</span>
                </p>
            </div>
            {% endif %}
            <div class="user__stats-wrapper">
                <div class="user__stats stats">
                    <div class="stats__item">
                        <p>{{ t('common', 'Убийств') }}</p>
                        <p>{{ STATS.getParam(USER_STATS, 'kills')|number_format(0, '', ' ') }}</p>
                    </div>
                    <div class="stats__item">
                        <p>{{ t('common', 'Смертей') }}</p>
                        <p>{{ STATS.getParam(USER_STATS, 'deaths')|number_format(0, '', ' ') }}</p>
                    </div>
                    <div class="stats__item">
                        <p>K/D</p>
                        <p>{{ STATS.getParam(USER_STATS, 'kd')|number_format(2, '.', ' ') }}</p>
                    </div>
                    <div class="stats__item">
                        <p>{{ t('common', 'Убито ботов') }}</p>
                        <p>{{ STATS.getParam(USER_STATS, 'scientists')|number_format(0, '', ' ') }}</p>
                    </div>
                </div>
                <div class="user__stats stats">
                    <div class="stats__item stat" data-bs-toggle="tooltip" data-bs-title="{{ t('common', 'Серная руда') }}">
                        <img src="/images/design/user/gold.png" alt="gold" class="stat__image" loading="lazy"/>
                        <p class="p0">{{ STATS.getParam(USER_STATS, 'sulfur.ore')|number_format(0, '', ' ') }}</p>
                    </div>
                    <div class="stats__item stat" data-bs-toggle="tooltip" data-bs-title="{{ t('common', 'Железная руда') }}">
                        <img src="/images/design/user/iron_stone.png" alt="iron_stone" class="stat__image" loading="lazy"/>
                        <p class="p0">{{ STATS.getParam(USER_STATS, 'metal.ore')|number_format(0, '', ' ') }}</p>
                    </div>
                    <div class="stats__item stat" data-bs-toggle="tooltip" data-bs-title="{{ t('common', 'Камень') }}">
                        <img src="/images/design/user/stone.png" alt="stone" class="stat__image" loading="lazy"/>
                        <p class="p0">{{ STATS.getParam(USER_STATS, 'stones')|number_format(0, '', ' ') }}</p>
                    </div>
                    <div class="stats__item stat" data-bs-toggle="tooltip" data-bs-title="{{ t('common', 'Дерево') }}">
                        <img src="/images/design/user/wood.png" alt="wood" class="stat__image" loading="lazy"/>
                        <p class="p0">{{ STATS.getParam(USER_STATS, 'wood')|number_format(0, '', ' ') }}</p>
                    </div>
                </div>

                <!-- Награды -->
                {% if SETTINGS.get('section_tasks') %}
                <div class="user__awards awards">
                    <p class="awards__title">
                        {{ t('common', 'Награды') }}
                        <span
                                class="icons icons_24px icons_24px_info icons_hover"
                                data-bs-toggle="tooltip"
                                data-bs-placement="right"
                                data-bs-title="{{ t('common', 'Выполни все задания, чтобы получить награду') }}"
                        ></span>
                    </p>
                    {% if AWARDS and AWARDS|length > 0 %}
                        <div class="awards__wrapper">
                            <div class="awards__list">
                                {% for AWARD in AWARDS %}
                                    <img src="{{ AWARD.image }}"
                                     alt="award"
                                     class="awards__image"
                                     data-bs-toggle="tooltip"
                                     data-bs-placement="right"
                                     data-bs-title="{{ AWARD.name }}" />
                                {% endfor %}
                            </div>
                            {% if AWARDS_STATS %}
                            <a href="/tasks-v2" class="awards__stats">
                                {{ t('common', 'выполнено {completed} из {total} заданий', {'completed': AWARDS_STATS.completed, 'total': AWARDS_STATS.total}) }}
                            </a>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="daily-reward__description">
                            <span>
                                {{ t('common', 'Выполняй задания и <a href="/tasks-v2" class="p0">получай награды</a>.')|raw }}
                            </span>
                        </p>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% if SETTINGS.get('design_statsBlockImageVideo') %}
                <video class="user__image" playsinline loop autoplay muted data-lazy="true" preload="none" poster="{{ SETTINGS.get('design_statsBlockImage') }}">
                    <source type="video/webm" src="{{ SETTINGS.get('design_statsBlockImageVideo') }}">
                </video>
            {% else %}
                <img src="{{ SETTINGS.get('design_statsBlockImage') }}" alt="farmer" class="user__image" loading="lazy"/>
            {% endif %}
            <div class="user__stats_footer">
                {% if USER.USER_STATS_LINK %}
                    <a href="{{ USER.USER_STATS_LINK }}" class="button button-primary snow-drift snow-drift-1 snow-drift-right">
                        <span class="button__text">{{ t('common', 'Моя статистика') }}</span>
                    </a>
                {% else %}
                    <a href="/servers/{{ USER.SERVER_ACTIVE_TAG }}" class="button button-primary snow-drift snow-drift-1 snow-drift-right">
                        <span class="button__text">{{ t('common', 'Статистика игроков') }}</span>
                    </a>
                {% endif %}
                <a href="/user/profile" class="button button-secondary">
                    <span class="button__text">{{ t('common', 'Мой профиль') }}</span>
                </a>
            </div>
        </section>
    {% endif %}

    <section class="daily-reward">
        <h2 class="daily-reward__title">{{ t('common', 'Ежедневная награда') }}</h2>
        <p class="daily-reward__description">
              <span>
                {{ t('common', "Переходи в наш <a href=\"{BOT_PARAM_LINK}\" class=\"p0\" rel=\"nofollow\" target=\"_blank\">Telegram-бот</a> для получения ежедневного бонуса.", {BOT_PARAM_LINK: BOT_LINK})|raw }}
              </span>
            <span
            >{{ t('common', 'Напиши') }} <span
                        style="color: var(--link-color-default)"
                        class="btn-clipboard"
                        data-clipboard-text="/bonus"
                        data-message="{{ t('common', 'Команда скопирована в буфер обмена!') }}"
                        data-bs-toggle="tooltip"
                        data-bs-placement="bottom"
                        data-bs-title="{{ t('common', 'Скопировать команду') }}">/bonus</span> {{ t('common', 'в боте, чтобы получить награду') }}</span>
        </p>

        {% if SETTINGS.get('design_bonusBlockImageVideo') %}
            <video class="daily-reward__image" playsinline loop autoplay muted data-lazy="true" preload="none" poster="{{ SETTINGS.get('design_bonusBlockImage') }}">
                <source type="video/webm" src="{{ SETTINGS.get('design_bonusBlockImageVideo') }}">
            </video>
        {% else %}
            <img src="{{ SETTINGS.get('design_bonusBlockImage') }}" alt="symbol" loading="lazy" class="daily-reward__image"/>
        {% endif %}
        <a href="{{ BOT_LINK }}" rel="nofollow" target="_blank" class="button button-secondary snow-drift snow-drift-2 snow-drift-right" style="padding-top: 15px;">
            <span class="button__text">{{ t('common', 'Получить бонус') }}</span>
        </a>
    </section>
</div>