<div class="owl-carousel categories__carousel">
    {% for item in ITEMS %}
        <div class="category" data-id="{{ item.id }}">
            {% if (SETTINGS.get('colors_categories-is-image')) %}
                <img src="{{ item.image }}" alt="{{ t('database', item.name) }}" class="category__image" />
            {% endif %}
            <p class="category__title">{{ t('database', item.name) }}</p>
        </div>
    {% endfor %}
</div>