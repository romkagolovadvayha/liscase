<div class="category__cards" id="products">
    {% set i = 0 %}
    {% for item in PRODUCT_DROPS %}
        {% include 'product.twig'
            with {
            'URL': "/market/form-modal?id=#{item.id}",
            'PRICE': item.price,
            'PRICE_REAL': item.getRealPrice(),
            'CURRENCY': 'RUB',
            'DISCOUNT': item.discount,
            'NAME': item.name,
            'CATEGORY_ID': item.category_id,
            'IMAGE': IMAGES[item.id]['150px'],
            'COUNT': item.count,
            'BLOCKED': item.blocked(),
            'BLOCKED_AT': item.blocked_at,
            'BLOCKED_TIME': item.blockedTime(),
            'INDEX': i,
        }
        %}
        {% set i = i + 1 %}
    {% endfor %}
</div>