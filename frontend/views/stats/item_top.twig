<section class="the-best__item">
    <h4 class="text-text-main mb-20 relative z-1">{{ TITLE }}</h4>

    <ol class="the-best__list">
        {% for ITEM in ITEMS %}
        <li>
            <a href="{{ ITEM.link }}" class="the-best__list__item__wrap">
                <div class="the-best__list__avatar">
                    <img src="{{ ITEM.avatar }}" alt="{{ ITEM.username }}" />
                </div>
                <div class="the-best__list__item{% if ITEM.steam_id == USER.steam_id %} active{% endif %}">
                    <div class="the-best__list__item_header">
                        <div class="the-best__list__item_header_name">{{ ITEM.username }}</div>
                        {% if ITEM.steam_id == USER.steam_id %}
                            <span class="the-best__list__item_header_label">{{ t('common', 'вы') }}</span>
                        {% endif %}
                    </div>
                    <div class="the-best__list__item_footer">
                        {% if ITEM.amount > 0 %}
                        <div class="the-best__list__item_reward">
                            <span class="icons icons_16px icons_16px_trophy bg-system-colors-{{ ITEM.color }}"></span>
                            <span class="p3 text-text-main">{{ ITEM.amount }}</span>
                            <span class="icons icons_16px icons_16px_coin"></span>
                        </div>
                        {% endif %}
                        <div class="the-best__list__item_footer_score">{{ ITEM.score }}</div>
                    </div>
                </div>
            </a>
        </li>
        {% endfor %}
    </ol>
    {% if ALL_USER_TOP %}
        <div class="mt-24 p2 text-secondary text-center flex align-center gap-x-5 justify-center">
        {% if ALL_USER_TOP[KEY] and ALL_USER_TOP[KEY]['items'] and ALL_USER_TOP[KEY]['items'][USER.steam_id] %}
            {% if ALL_USER_TOP[KEY]['items'][USER.steam_id].position == 1 %}
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-gold"></span> {{ t('common', 'Вы на первом месте') }}
            {% elseif ALL_USER_TOP[KEY]['items'][USER.steam_id].position == 2 %}
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-silver"></span> {{ t('common', 'Вы на втором месте') }}
            {% elseif ALL_USER_TOP[KEY]['items'][USER.steam_id].position == 3 %}
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-bronze"></span> {{ t('common', 'Вы на третьем месте') }}
            {% else %}
                {{ t('common', 'Вы на') }} {{ ALL_USER_TOP[KEY]['items'][USER.steam_id].position }} {{ t('common', 'месте') }}
            {% endif %}
        {% else %}
            {{ t('common', 'Вы на') }} {{ ALL_USER_TOP[KEY]['items']|length}} {{ t('common', 'месте') }}
        {% endif %}
        </div>
    {% endif %}
</section>