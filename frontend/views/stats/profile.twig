<section class="page-stats__block profile w-50p">
    <!-- ОНЛАЙН -->
    <div class="profile__wrapper{{ WRAPPER_CLASS }}">
        <div class="profile__image">
            <img src="{{ USER.getAvatar() }}" alt="{{ USER.username }}" />
        </div>
        <div>
            <h2 class="text-primary-colors-main flex items-center gap-x-12">
                {{ USER.username }} <a href="{{ USER.getLink('steam') }}" class="stats_player_card_body_name_steam" target="_blank" title="<?=Yii::t('common', 'Перейти в профиль Steam')?>"><span class="icons icons_24px icons_24px_steam"></span></a>
            </h2>
            <p class="p1 text-text-main">
                {% if STATS.PLAYTIME > 0 %}{{ t('common', 'Онлайн за вайп') }}: <span style="color: var(--online);">{{ STATS.ONLINE }}</span>{% else %}{{ t('common', 'Не заходил на сервер') }}{% endif %}
            </p>
        </div>
    </div>

{#    <p class="p1 text-text-secondary mb-8 relative z-1">{{ t('common', 'Статус') }}</p>#}
{#    <p class="p1 text-text-teritiary relative z-1">#}
{#        {% if USER.stat_status %}#}
{#            {{ USER.stat_status }}#}
{#        {% else %}#}
{#            {{ t('common', 'Игрок не указал статус.') }}#}
{#        {% endif %}#}
{#    </p>#}

    <div class="user__stats stats">
        <div class="stats__item">
            <p>{{ t('common', 'Убийств') }}</p>
            <p>{{ STATS.KILLS }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Смертей') }}</p>
            <p>{{ STATS.DEATHS }}</p>
        </div>
        <div class="stats__item">
            <p>K/D</p>
            <p>{{ STATS.KD }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Убил ботов') }}</p>
            <p>{{ STATS.SCIENTISTS }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Нокнут') }}</p>
            <p>{{ STATS.WOUNDED }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Зарейдил') }}</p>
            <p>{{ STATS.TCS_DESTOYED }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Вайпов') }}</p>
            <p>{{ STATS.WIPES }}</p>
        </div>
        <div class="stats__item">
            <p>{{ t('common', 'Убил голых') }}</p>
            <p>{{ STATS.NUDE_KILLS }}</p>
        </div>
    </div>

    <!-- Социальные сети -->
    {% if USER.userProfile.youtube_link or USER.userProfile.tiktok_link or USER.userProfile.twitch_link %}
    <div class="social-links mb-16">
        <h5 class="p1 text-text-teritiary mb-8">{{ t('common', 'Социальные сети') }}</h5>
        <div class="flex items-center gap-x-12">
            {% if USER.userProfile.youtube_link %}
            <a href="{{ USER.userProfile.youtube_link }}" target="_blank" class="flex items-center gap-x-4 text-text-main hover:text-primary-colors-main" title="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span class="p2">YouTube</span>
            </a>
            {% endif %}
            
            {% if USER.userProfile.tiktok_link %}
            <a href="{{ USER.userProfile.tiktok_link }}" target="_blank" class="flex items-center gap-x-4 text-text-main hover:text-primary-colors-main" title="TikTok">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
                <span class="p2">TikTok</span>
            </a>
            {% endif %}
            
            {% if USER.userProfile.twitch_link %}
            <a href="{{ USER.userProfile.twitch_link }}" target="_blank" class="flex items-center gap-x-4 text-text-main hover:text-primary-colors-main" title="Twitch">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                </svg>
                <span class="p2">Twitch</span>
            </a>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <div class="profile__footer">
        {% if not IS_GUEST %}
        <a href="{{ USER.getLink('report') }}" class="flex items-center gap-x-8 relative z-1 show-modal-link"
           data-size="modal-lg"
           data-toggl="modal"
           data-target="modal-dialog"
           data-title="{{ t('common', 'Пожаловаться на игрока') }}">
            <span class="icons icons_24px icons_24px_report"></span>
            {{ t('common', 'Пожаловаться') }}
        </a>
        {% endif %}
    </div>
</section>