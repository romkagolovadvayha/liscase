<!-- Награды -->
{% set totalAwards = ITEMS|length %}
{% set visibleAwards = ITEMS|slice(0, 8) %}
{% set hiddenAwards = ITEMS|slice(8) %}
{% set hasMore = hiddenAwards|length > 0 %}

<section class="page-stats__block-without-hover">
    <h3 class="flex items-center justify-space-between gap-x-12 mb-24">
        <span class="flex items-center gap-x-12">
            {{ t('common', 'Награды') }}<span
                    class="icons icons_24px icons_24px_info icons_hover"
                    data-bs-toggle="tooltip"
                    data-bs-placement="right"
                    data-bs-title="{{ t('common', 'Выполни все задания, чтобы получить награду') }}"
            ></span>
        </span>
        {% if AWARDS_STATS %}
        <a href="/tasks-v2" class="awards__stats-link">
            {{ t('common', 'выполнено {completed} из {total} заданий', {'completed': AWARDS_STATS.completed, 'total': AWARDS_STATS.total}) }}
        </a>
        {% endif %}
    </h3>

    <div class="page-stats__awards">
        {% for ITEM in visibleAwards %}
            <div class="award{% if not ITEM.completed %} award_is-not-completed{% endif %}">
                <img src="{{ ITEM.image }}" alt="{{ ITEM.name }}" class="award__image" />
                <p class="p2">{{ ITEM.name }}</p>
            </div>
        {% endfor %}
        {% if hasMore %}
            {% for ITEM in hiddenAwards %}
                <div class="award awards-item-hidden{% if not ITEM.completed %} award_is-not-completed{% endif %}" style="display: none;">
                    <img src="{{ ITEM.image }}" alt="{{ ITEM.name }}" class="award__image" />
                    <p class="p2">{{ ITEM.name }}</p>
                </div>
            {% endfor %}
        {% endif %}
    </div>
    
    {% if hasMore %}
        <button type="button" class="awards-show-more-btn button button-secondary w-full mt-16" data-text-more="{{ t('common', 'Показать еще {count}') }}" data-text-less="{{ t('common', 'Скрыть') }}">
            <span class="awards-show-more-text">{{ t('common', 'Показать еще {count}', {'count': hiddenAwards|length}) }}</span>
            <i class="fas fa-chevron-down"></i>
        </button>
    {% endif %}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const showMoreBtn = document.querySelector('.awards-show-more-btn');
    if (!showMoreBtn) return;
    
    const hiddenItems = document.querySelectorAll('.awards-item-hidden');
    if (hiddenItems.length === 0) return;
    
    const textElement = showMoreBtn.querySelector('.awards-show-more-text');
    const iconElement = showMoreBtn.querySelector('i');
    
    if (!textElement) return;
    
    let isExpanded = false;
    
    showMoreBtn.addEventListener('click', function() {
        isExpanded = !isExpanded;
        
        if (isExpanded) {
            hiddenItems.forEach(item => {
                item.style.display = '';
            });
            textElement.textContent = showMoreBtn.dataset.textLess;
            if (iconElement) {
                iconElement.classList.add('awards-show-more-icon--rotated');
            }
        } else {
            hiddenItems.forEach(item => {
                item.style.display = 'none';
            });
            textElement.textContent = showMoreBtn.dataset.textMore.replace('{count}', hiddenItems.length);
            if (iconElement) {
                iconElement.classList.remove('awards-show-more-icon--rotated');
            }
        }
    });
});
</script>