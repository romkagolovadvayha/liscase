<!-- Задания на вайп -->
<section class="tasks">
    <h2 class="tasks__title">
        {{ t('common', 'Ежедневная награда') }}
        <span
                class="icons icons_24px icons_24px_info icons_hover"
                data-bs-toggle="tooltip"
                data-bs-placement="right"
                data-bs-title="{{ t('common', 'Забирайте бонусы за ежедневный вход в личный кабинет без пропусков. Кнопку “Забрать” нужно нажимать ежедневно, иначе счетчик дней начнется заново. Начисление производится на ваш игровой счет.') }}"
        ></span>
    </h2>
    <section class="page-stats__block-without-hover">
        <div class="page-stats__categories">
            {% for ITEM in ACHIEVMENTS_DAILY.items %}
                <div class="page-stats__category category{% if ITEM.status %} {{ ITEM.status }}{% endif %}">
                    <h5 class="category__count-and-img">
                        <span>x{{ ITEM.amount }}</span>
                        <img src="{{ ITEM.image }}" alt="{{ ITEM.name }}" class="w-64 h-64 object-contain">
                    </h5>
                    <p class="category__title">{{ ITEM.name }}</p>
                </div>
            {% endfor %}
        </div>
        <div class="page-stats__categories__footer">
            {% if not ACHIEVMENTS_DAILY.received %}
                <div class="button button-disabled w-full" disabled>
                    <span class="button__text">{{ t('common', 'Возвращайся завтра') }}</span>
                </div>
            {% else %}
                <a href="/user/get-daily-reward" class="button button-primary w-full">
                    <span class="button__text">{{ t('common', 'Забрать награду') }}</span>
                </a>
            {% endif %}
        </div>
    </section>
</section>