                {
                    'label': t('common', 'FAQ'),
                    'url': '/faq',
                    'iconClass': 'icons icons_32px icons_32px_faq',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'visibility': false,
                    'options': {'class': 'menu__item'},
                },
            ]
        })
        }}
