{{ use('common/components/widgets') }}

<aside {% if not MOBILE %}class="menu mobile_hide" id="main-menu" {% if MENU_HIDDEN %}style="width: 102px;"{% endif %}{% endif %}>
    {% if not MOBILE %}
        <button class="menu__button" id="menu-toggle-button" type="button">
            <span class="icons icons_16px icons_16px_arrow_left" id="menu-button-arrow-left"></span>
            <span class="icons icons_16px icons_16px_arrow_right" id="menu-button-arrow-right"></span>
        </button>
    {% endif %}

    <nav>
        <!-- СОЦИАЛЬНЫЕ СЕТИ -->
        <div class="menu__social-network_wrap"{% if MENU_HIDDEN %} style="display: none"{% endif %}>
            {{ nav_menu_widget({
                'options': {
                    'class': 'menu__social-network social-network',
                },
                'activateItems': false,
                'items': [
                    {
                        'label': '',
                        'url': SETTINGS.get('social_telegram'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_telegram',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_telegram'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Telegram"}
                    },
                    {
                        'label': '',
                        'url': SETTINGS.get('social_vk'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_vk',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_vk'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "VK"}
                    },
                    {
                        'label': '',
                        'url': SETTINGS.get('social_discord'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_discord',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_discord'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Discord"}
                    },
                ]
            })
            }}
        </div>

        <div class="menu__list_wrap"{% if MENU_HIDDEN %} style="margin-top: 40px"{% endif %}>
        <!-- РАЗДЕЛЫ -->
        {{ nav_menu_widget({
            'options': {
                'class': 'menu__list',
            },
            'menuHidden': MENU_HIDDEN,
            'items': [
                {
                    'label': t('common', 'Статистика'),
                    'url': "/servers/#{USER.SERVER_ACTIVE_TAG}",
                    'iconClass': 'icons icons_32px icons_32px_statistics',
                    'activeClass': 'menu__item_active',
                    'active': PAGE == 'stats',
                    'spanClass': 'main-menu-text',
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Бан-лист'),
                    'url': '/banlist',
                    'iconClass': 'icons icons_32px icons_32px_ban',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'active': PAGE == 'bans',
                    'notification': NOTIFICATIONS.BANS,
                    'visibility': SETTINGS.get('section_banlist'),
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Блог'),
                    'url': '/posts',
                    'iconClass': 'icons icons_32px icons_32px_ban',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'active': PAGE == 'blog',
                    'visibility': SETTINGS.get('section_blog'),
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Наши сервера'),
                    'url': '/servers',
                    'iconClass': 'icons icons_32px icons_32px_servers',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Постройки'),
                    'url': '/buildings',
                    'iconClass': 'icons icons_32px icons_32px_buildings',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'active': PAGE == 'buildings',
                    'visibility': SETTINGS.get('section_buildings'),
                    'notification': NOTIFICATIONS.BUILDINGS,
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Рейтинг кланов'),
                    'url': '/clans',
                    'iconClass': 'icons icons_32px icons_32px_rate',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'visibility': SETTINGS.get('section_clans'),
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Правила серверов'),
                    'url': "/servers/#{USER.SERVER_ACTIVE_TAG}/rules",
                    'iconClass': 'icons icons_32px icons_32px_rules',
                    'activeClass': 'menu__item_active',
                    'active': PAGE == 'rules',
                    'spanClass': 'main-menu-text',
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Как получать скины'),
                    'url': '/skindrops',
                    'iconClass': 'icons icons_32px icons_32px_rate',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'visibility': SETTINGS.get('section_skindrops'),
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Поддержка'),
                    'url': '/support',
                    'iconClass': 'icons icons_32px icons_32px_support',
                    'activeClass': 'menu__item_active',
                    'active': PAGE == 'support',
                    'spanClass': 'main-menu-text',
                    'visibility': SETTINGS.get('section_support'),
                    'notification': NOTIFICATIONS.SUPPORT,
                    'options': {'class': 'menu__item menu__item_support'},
                },
                {
                    'label': t('common', 'Выбор карты'),
                    'url': "/maps/#{USER.SERVER_ACTIVE_TAG}",
                    'iconClass': 'icons icons_32px icons_32px_support',
                    'activeClass': 'menu__item_active',
                    'active': PAGE == 'maps',
                    'visibility': SETTINGS.get('section_maps'),
                    'spanClass': 'main-menu-text',
                    'options': {'class': 'menu__item menu__item_maps'},
                },
                {
                    'label': t('common', 'Добавление скинов'),
                    'url': "/maps/#{USER.SERVER_ACTIVE_TAG}",
                    'iconClass': 'icons icons_32px icons_32px_support',
                    'activeClass': 'menu__item_active',
                    'active': PAGE == 'skins',
                    'visibility': SETTINGS.get('section_skins'),
                    'spanClass': 'main-menu-text',
                    'options': {'class': 'menu__item menu__item_skins'},
                },
                {
                    'label': t('common', 'Промокоды'),
                    'url': '/promocodes',
                    'iconClass': 'icons icons_32px icons_32px_promo',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
                    'visibility': false,
                    'options': {'class': 'menu__item'},
                },
                {
                    'label': t('common', 'Реферальная система'),
                    'url': '/referral',
                    'iconClass': 'icons icons_32px icons_32px_promo',
                    'activeClass': 'menu__item_active',
                    'spanClass': 'main-menu-text',
