{{ use('common/components/widgets') }}

<aside {% if not MOBILE %}class="menu" id="main-menu" {% if MENU_HIDDEN %}style="width: 102px;"{% endif %}{% endif %}>
    {% if not MOBILE %}
        <button class="menu__button" id="menu-toggle-button" type="button" title="{{ t('common', 'Свернуть') }}">
            <span class="icons icons_16px icons_16px_arrow_left" id="menu-button-arrow-left"></span>
            <span class="icons icons_16px icons_16px_arrow_right" id="menu-button-arrow-right"></span>
        </button>
    {% endif %}

    <nav>
        <!-- СОЦИАЛЬНЫЕ СЕТИ -->
        <div class="menu__social-network_wrap"{% if MENU_HIDDEN %} style="display: none"{% endif %}>
            {{ nav_menu_widget({
                'options': {
                    'class': 'menu__social-network social-network',
                },
                'activateItems': false,
                'items': [
                    {
                        'label': '',
                        'url': SETTINGS.get('social_telegram_channel'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_telegram',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_telegram_channel'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Telegram", 'title': "Telegram", 'rel': 'nofollow'}
                    },
                    {
                        'label': '',
                        'url': SETTINGS.get('social_vk'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_vk',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_vk'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "VK", 'title': "VK", 'rel': 'nofollow'}
                    },
                    {
                        'label': '',
                        'url': SETTINGS.get('social_discord'),
                        'iconClass': 'icons icons_hover icons_32px icons_32px_discord',
                        'options': {'class': ''},
                        'visibility': SETTINGS.get('social_discord'),
                        'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Discord", 'title': "Discord", 'rel': 'nofollow'}
                    },
                ]
            })
            }}
        </div>

        <div class="menu__list_wrap"{% if MENU_HIDDEN %} style="margin-top: 40px"{% endif %}>
        {% include 'nav.twig'
            with {
                'SETTINGS': SETTINGS,
                'PAGE': PAGE,
                'USER': USER,
                'USER_GUEST': USER_GUEST,
                'CLASS': 'menu__list',
                'CLASS_ITEM': 'menu__item',
                'CLASS_ITEM_ACTIVE': 'menu__item_active',
                'CLASS_ITEM_SPAN_TEXT': 'main-menu-text',
                'CLASS_ICON': '',
            }
        %}
        </div>
    </nav>
</aside>