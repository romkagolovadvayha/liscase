{{ HEADER|raw }}
<main class="main{% if MENU_HIDDEN %} main_menu_hide{% endif %} {{ PAGE }}">
    <!-- МЕНЮ -->
    {{ MENU|raw }}
    <!-- КОНТЕНТ -->
    <section class="container main-content">
        {% if H1 %}<h1 class="mb-24 h2">{{ H1 }}</h1>{% endif %}
        {% if breadcrumbs %}
            <div class="breadcrumbs_wrap mb-12">
                {{ breadcrumbs|raw }}
            </div>
        {% endif %}
        {{ content|raw }}
    </section>
    <!-- ВИДЖЕТЫ -->
    <aside class="stats-aside mobile_hide">
{#        {{ ALERT_MESSAGE|raw }}#}
{#        {{ SKINDROPS_BLOCK|raw }}#}
        {{ SERVER_INFO_BLOCK|raw }}
        {% include '@frontend/views/widgets/_banner_side.twig' with {'SETTINGS': SETTINGS, 'lang': lang} %}
        {{ BLOG_POPULAR_LIST_BLOCK|raw }}
        {{ BLOG_COMMENTS_LIST_BLOCK|raw }}
        {{ BLOG_CATEGORY_LIST_BLOCK|raw }}
        {{ PROFILE_BLOCK|raw }}
        {{ BUILDINGS_BLOCK|raw }}
        {{ TEAMS_BLOCK|raw }}
        {{ KILLS_BLOCK|raw }}
        {{ SERVERS_BLOCK|raw }}
        {{ TOP_BLOCK|raw }}
        {{ LIVE_BLOCK|raw }}
    </aside>
</main>

{{ FOOTER|raw }}
{{ MODAL|raw }}
<!-- Мобильное меню -->
<div id="mobile-menu-modal" class="mobile-menu-modal" style="display: none;">
    <div class="mobile-menu-modal__overlay"></div>
    <div class="mobile-menu-modal__content">
        <div class="mobile-menu-modal__header">
            <h2>{{ t('common', 'Меню') }}</h2>
            <button class="mobile-menu-modal__close" type="button" aria-label="{{ t('common', 'Закрыть') }}">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="mobile-menu-modal__body">
            {{ MOBILE_MENU|raw }}
        </div>
    </div>
</div>
<div class="loader" id="loader"></div>