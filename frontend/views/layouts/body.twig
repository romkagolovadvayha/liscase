{{ HEADER|raw }}
<main class="main{% if MENU_HIDDEN %} main_menu_hide{% endif %}">
    <!-- МЕНЮ -->
    {{ MENU|raw }}
    <!-- КОНТЕНТ -->
    <section class="container main-content">
        {% if H1 %}<h1 class="mb-24 h2">{{ H1 }}</h1>{% endif %}
        {% if breadcrumbs %}
            <div class="breadcrumbs_wrap mb-12">
                {{ breadcrumbs|raw }}
            </div>
        {% endif %}
        {{ content|raw }}
    </section>
    <!-- ВИДЖЕТЫ -->
    <aside class="stats-aside mobile_hide">
{#        {{ ALERT_MESSAGE|raw }}#}
{#        {{ SKINDROPS_BLOCK|raw }}#}
        {{ BLOG_CATEGORY_LIST_BLOCK|raw }}
        {{ BLOG_SIMILAR_LIST_BLOCK|raw }}
        {{ BLOG_COMMENTS_LIST_BLOCK|raw }}
        {{ PROFILE_BLOCK|raw }}
        {{ BUILDINGS_BLOCK|raw }}
        {{ TEAMS_BLOCK|raw }}
        {{ KILLS_BLOCK|raw }}
        {{ SERVERS_BLOCK|raw }}
{#        {{ TOP_BLOCK|raw }}#}
{#        {{ LIVE_BLOCK|raw }}#}
    </aside>
</main>

{{ FOOTER|raw }}
{{ MODAL|raw }}
<div class="loader" id="loader"></div>