<footer class="footer">
    <div class="footer__main-links footer_logo_block">
        <a href="{{ HOME_URL }}" class="footer_logo mb-48">
            <img src="{{ SETTINGS.get('design_logo') }}" alt="" />
        </a>

        <a href="mailto:{{ SETTINGS.get('site_email') }}" class="mb-24 p1">{{ SETTINGS.get('site_email') }}</a>

        {{ nav_menu_widget({
            'options': {
                'class': 'footer__social-network social-network',
            },
            'activateItems': false,
            'items': [
                {
                    'label': '',
                    'url': SETTINGS.get('social_telegram'),
                    'iconClass': 'icons icons_hover icons_32px icons_32px_telegram',
                    'options': {'class': ''},
                    'visibility': SETTINGS.get('social_telegram'),
                    'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Telegram"}
                },
                {
                    'label': '',
                    'url': SETTINGS.get('social_vk'),
                    'iconClass': 'icons icons_hover icons_32px icons_32px_vk',
                    'options': {'class': ''},
                    'visibility': SETTINGS.get('social_vk'),
                    'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "VK"}
                },
                {
                    'label': '',
                    'url': SETTINGS.get('social_discord'),
                    'iconClass': 'icons icons_hover icons_32px icons_32px_discord',
                    'options': {'class': ''},
                    'visibility': SETTINGS.get('social_discord'),
                    'linkOptions': {'target': '_blank', 'data-bs-toggle': "tooltip", 'data-bs-placement': "bottom", 'data-bs-title': "Discord"}
                },
            ]
        })
        }}
    </div>

    <nav class="footer__menu-links mobile_hide">
        {% include 'nav.twig'
            with {
                'SETTINGS': SETTINGS,
                'PAGE': PAGE,
                'CLASS': '',
                'CLASS_ITEM': 'text-text-teritiary',
                'CLASS_ITEM_ACTIVE': '',
                'CLASS_ITEM_SPAN_TEXT': '',
                'CLASS_ICON': 'none',
            }
        %}
        <ul>
            <li><a href="/site/agreement" class="text-text-teritiary">{{ t('common', 'Пользовательское соглашение') }}</a></li>
            <li><a href="/site/privacy" class="text-text-teritiary">{{ t('common', 'Политика конфиденциальности') }}</a></li>
            <li><a href="/site/personalinformation" class="text-text-teritiary">{{ t('common', 'Обработка персональных данных') }}</a></li>
        </ul>
    </nav>

    <div class="footer__rules">
        <p class="p3 text-text-secondary mb-24">
            {{ t('common', 'Размещенная на настоящем сайте информация носит исключительно информационный характер и ни при каких условиях не является публичной офертой, определяемой положениями ч. 2 ст. 437 Гражданского кодекса Российской Федерации.') }}
        </p>
        <p class="p3 text-text-secondary mb-12">
            {{ t('common', 'ИНН') }} {{ SETTINGS.get('personal_info_ip_inn') }}
        </p>
        <p class="p3 text-text-secondary mb-24">
            {{ t('common', SETTINGS.get('personal_info_ip_fio')) }}
        </p>

        <p class="p3 text-text-secondary">© 2025 {{ DOMAIN }}</p>
    </div>
</footer>