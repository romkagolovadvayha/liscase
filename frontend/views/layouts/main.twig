    <div id="cc-mini" hidden aria-live="polite" role="dialog" aria-label="{{ t('common', 'Согласие на cookies') }}">
        <div class="cc-box">
            <div>{{ t('common', 'Мы используем cookies для работы сайта и аналитики.') }}</div>
            <button id="cc-accept" class="button button-primary button-size__s h-36" style="padding-top: 6px; padding-bottom: 6px"><span class="button__text">{{ t('common', 'Принять') }}</span></button>
        </div>
