    <div id="cc-mini" hidden aria-live="polite" role="dialog" aria-label="{{ t('common', 'Согласие на cookies') }}">
        <div class="cc-box">
            <div>{{ t('common', 'Мы используем cookies для работы сайта и аналитики.') }}</div>
            <button id="cc-accept" class="button button-primary button-size__s h-36" style="padding-top: 6px; padding-bottom: 6px"><span class="button__text">{{ t('common', 'Принять') }}</span></button>
        </div>
    </div>

    <script>
        (function(){
            const KEY='consent:v1';
            const MAX_AGE=31536000; // 1 год
            const $bar=document.getElementById('cc-mini');
            const $btn=document.getElementById('cc-accept');

            function setConsent(accepted){
                const c={necessary:true,analytics:!!accepted,date:Date.now()};
                try{ localStorage.setItem(KEY, JSON.stringify(c)); }catch(e){}
                const base='; Max-Age='+MAX_AGE+'; Path=/; SameSite=Lax'+(location.protocol==='https:'?'; Secure':'');
                document.cookie='consent_analytics='+(c.analytics?1:0)+base;
                if(accepted && typeof window.onConsentGranted==='function'){
                    try{ window.onConsentGranted(); }catch(e){}
                }
            }

            function already(){
                try{ return JSON.parse(localStorage.getItem(KEY)); }catch(e){ return null; }
            }

            const saved=already();
            if(!saved){
                $bar.hidden=false;
                let t=setTimeout(function(){ setConsent(true); $bar.remove(); }, 10000); // автопринятие через 10 сек
                $btn.addEventListener('click', function(){
                    clearTimeout(t);
                    setConsent(true);
                    $bar.remove();
                });
            }else if(saved.analytics){
                // при повторном визите можно сразу применять интеграции
                if(typeof window.onConsentGranted==='function'){ window.onConsentGranted(); }
            }

            // (необязательно) сделай глобальный метод, чтобы открыть баннер снова:
            window.CookieConsentMini={ open:()=>{ $bar.hidden=false; } };
        })();
    </script>
    
    {# PWA Service Worker Registration #}
    <script>
        const PWA_DEBUG = {{ constant('YII_ENV_DEV') ? 'true' : 'false' }};
        const swFile = PWA_DEBUG ? '/sw-debug.js' : '/sw.js';
        const pwaLog = (...args) => { if (PWA_DEBUG) { console.log('[PWA]', ...args); } };
        const pwaError = (...args) => console.error('[PWA]', ...args);

        pwaLog('Initializing PWA...');

        if ('serviceWorker' in navigator) {
            pwaLog('Service Worker supported');

            window.addEventListener('load', function() {
                pwaLog('Page loaded, registering SW...', swFile);

                navigator.serviceWorker.register(swFile)
                    .then(function(registration) {
                        pwaLog('Service Worker registered:', registration.scope);

                        if (PWA_DEBUG) {
                            registration.addEventListener('updatefound', function() {
                                pwaLog('Update found');
                                const newWorker = registration.installing;
                                if (!newWorker) {
                                    return;
                                }
                                newWorker.addEventListener('statechange', function() {
                                    pwaLog('New worker state:', newWorker.state);
                                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                        if (confirm('Доступна новая версия приложения. Обновить?')) {
                                            window.location.reload();
                                        }
                                    }
                                });
                            });
                        }
                    })
                    .catch(function(error) {
                        pwaError('Service Worker registration failed:', error);
                    });
            });
        } else {
            pwaLog('Service Worker not supported');
        }

        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', function(e) {
            pwaLog('Install prompt triggered');
            e.preventDefault();
            deferredPrompt = e;
        });

        window.addEventListener('appinstalled', function(e) {
            pwaLog('App was installed successfully');
        });

        if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
            pwaLog('App is running in standalone mode');
        }

        pwaLog('beforeinstallprompt supported:', 'onbeforeinstallprompt' in window);

        window.addEventListener('online', function() {
            pwaLog('App is online');
        });

        window.addEventListener('offline', function() {
            pwaLog('App is offline');
        });

        function registerForPushNotifications() {
            if ('Notification' in window && 'serviceWorker' in navigator) {
                Notification.requestPermission().then(function(permission) {
                    if (permission === 'granted') {
                        pwaLog('Push notifications granted');
                    }
                });
            }
        }

        if (!localStorage.getItem('pwa-notifications-asked')) {
            setTimeout(registerForPushNotifications, 3000);
            localStorage.setItem('pwa-notifications-asked', 'true');
        }
    </script>
