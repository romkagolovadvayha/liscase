{{ use('kartik/grid/GridView') }}
<section class="tasks">
    <h2 class="tasks__title">
        {{ t('common', 'Бан лист') }}
        <span
                class="icons icons_24px icons_24px_info icons_hover"
                data-bs-toggle="tooltip"
                data-bs-placement="right"
                data-bs-title="{{ t('common', 'Список игроков получивших бан на наших серверах.') }}"
        ></span>
    </h2>

    <section class="page-stats__block-without-hover">
        {{ grid_view_widget({
            'dataProvider': dataProvider,
            'filterModel': searchModel,
            'layout': '{items} {pager}',
            'columns': [
                {
                    'attribute': 'avatar',
                    'label': '',
                    'format': 'raw',
                    'options': {'width': '50'},
                    'value': func.avatar
                },
                {
                    'attribute': 'steam_id',
                    'value': func.steam_id
                },
                {
                    'attribute': 'server_id',
                    'options': {'width': '150'},
                    'value': func.server_id
                },
                {
                    'attribute': 'banned_at',
                    'options': {'width': '200'},
                    'value': func.banned_at
                },
                {
                    'attribute': 'reason',
                    'options': {'width': '300'},
                },
            ]
        })
        }}
    </section>
</section>