{% if ITEMS %}
<section class="stats-aside__stat-block stat-block kills-widget">
    <div class="kills-widget__header">
        <h4 class="stat-block__title">
            {{ t('common', 'История убийств') }}
        </h4>
    </div>
    
    <div class="kills-widget__list">
        {% for ITEM in ITEMS %}
            {% include 'live_item.twig'
                with {
                'ITEM': ITEM,
            }
            %}
        {% endfor %}
    </div>
</section>
{% endif %}