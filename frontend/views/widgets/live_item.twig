<li class="kill-item">
    <div class="kill-item__weapon">
        {% if ITEM.weapon_image %}
            <img src="{{ ITEM.weapon_image }}" alt="{{ ITEM.weapon_name }}" loading="lazy">
        {% else %}
            <i class="fas fa-skull-crossbones"></i>
        {% endif %}
    </div>
    
    <div class="kill-item__content">
        <div class="kill-item__action">
            {% if ITEM.type == 'suicides' %}
                {{ ITEM.link|raw }}
                <span class="kill-item__text">{{ t('common', 'совершил самоубийство') }}</span>
            {% endif %}
            {% if ITEM.type == 'animal' %}
                {{ ITEM.link|raw }}
                <span class="kill-item__text">{{ t('common', 'убил') }} {{ ITEM.animal2 }}</span>
            {% endif %}
            {% if ITEM.type == 'deaths' %}
                <span class="kill-item__text">{{ ITEM.animal }} {{ t('common', 'убил') }}</span>
                {{ ITEM.link|raw }}
            {% endif %}
            {% if ITEM.type == 'scientists' %}
                {{ ITEM.link|raw }}
                <span class="kill-item__text">{{ t('common', 'убил бота') }}</span>
            {% endif %}
            {% if ITEM.type == 'kill' %}
                {% if ITEM.bot %}
                    <span class="kill-item__text">{{ t('common', 'Бот') }}</span>
                {% else %}
                    {{ ITEM.link|raw }}
                {% endif %}
                <i class="fas fa-arrow-right kill-item__arrow"></i>
                {{ ITEM.deadLink|raw }}
            {% endif %}
        </div>
        
        <div class="kill-item__footer">
            <div class="kill-item__distance">
                <i class="fas fa-ruler"></i>
                <span>{{ ITEM.distance }} {{ t('common', 'м') }}</span>
            </div>
            
            {% if ITEM.signs %}
                {% set break = false %}
                {% for SIGN in ITEM.signs %}
                    {% if not break %}
                        {% if SIGN == 'sleep' %}
                            <span class="kill-item__badge kill-item__badge--sleep">
                                <i class="fas fa-bed"></i>
                                {{ t('common', 'Спящий') }}
                            </span>
                            {% set break = true %}
                        {% endif %}
                        {% if SIGN == 'team' %}
                            <span class="kill-item__badge kill-item__badge--team">
                                <i class="fas fa-user-friends"></i>
                                {{ t('common', 'Тимейт') }}
                            </span>
                            {% set break = true %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% elseif ITEM.wears %}
                <span class="kill-item__badge kill-item__badge--naked">
                    <i class="fas fa-user"></i>
                    {{ t('common', 'Голый') }}
                </span>
            {% endif %}
        </div>
    </div>
</li>