<section class="stats-aside__stat-block stat-block">
    <h4 class="stat-block__title">{{ t('common', 'Топ игроков') }}</h4>

    <ul class="nav nav-tabs mb-20" role="tablist">
        {% for SERVER in SERVERS %}
            <li class="nav-item" role="presentation">
                <button class="nav-link{% if USER.SERVER_ACTIVE_ID == SERVER.id %} active{% endif %}" id="{{ SERVER.tag }}-top-tab" data-bs-toggle="tab" data-bs-target="#top_{{ SERVER.tag }}" type="button" role="tab" aria-controls="{{ SERVER.tag }}-top-tab-pane" aria-selected="{% if SERVER_ACTIVE_ID == SERVER.id %}true{% else %}false{% endif %}">
                    {{ SERVER.monitoring_name }}
                </button>
            </li>
        {% endfor %}
    </ul>
    <div class="tab-content">
        {% for SERVER in SERVERS %}
        <div id="top_{{ SERVER.tag }}" class="tab-pane{% if USER.SERVER_ACTIVE_ID == SERVER.id %} active{% else %} fade{% endif %}" role="tabpanel" aria-labelledby="#{{ SERVER.tag }}-top-tab">
            <ul class="stat-block__list">
                {% for LIST in TOP[SERVER.id] %}
                    <li class="gamer">
                        <img src="{{ LIST['items'][0].avatar }}" class="block w-36 h-36 min-w-36 min-h-36 rounded-6 border-1 border-solid border-system-colors-gold object-cover" alt="{{ ITEM.username }}">
                        <div class="block w-full relative z-1">
                            <p class="p2 flex items-center justify-space-between">
                                <span class="text-text-secondary">{{ LIST['label'] }}</span>
                                <span class="text-text-main">{{ LIST['items'][0].score }}</span>
                            </p>
                            <a href="{{ LIST['items'][0].link }}" class="link">{{ LIST['items'][0].username }}</a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
        {% endfor %}
    </div>

    <div class="flex justify-space-between items-center mb-12 mt-20">
        <p class="p2 text-text-secondary">{{ t('common', 'Награды') }}</p>

        <div class="flex items-center gap-x-16">
            {% if AMOUNT_GOLD > 0 %}
            <div class="flex items-center gap-x-4">
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-gold"></span>
                <span class="p2 text-text-main">{{ AMOUNT_GOLD }}</span>
                <span class="icons icons_16px icons_16px_coin"></span>
            </div>
            {% endif %}
            {% if AMOUNT_SILVER > 0 %}
            <div class="flex items-center gap-x-4">
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-silver"></span>
                <span class="p2 text-text-main">{{ AMOUNT_SILVER }}</span>
                <span class="icons icons_16px icons_16px_coin"></span>
            </div>
            {% endif %}
            {% if AMOUNT_BRONZE > 0 %}
            <div class="flex items-center gap-x-4">
                <span class="icons icons_16px icons_16px_trophy bg-system-colors-bronze"></span>
                <span class="p2 text-text-main">{{ AMOUNT_BRONZE }}</span>
                <span class="icons icons_16px icons_16px_coin"></span>
            </div>
            {% endif %}
        </div>
    </div>

    <a href="/servers/{{ USER.SERVER_ACTIVE_TAG }}" class="button button-secondary w-full">{{ t('common', 'Смотреть статистику') }}</a>
</section>