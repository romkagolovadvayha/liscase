<!-- Базы игрока -->
<section class="stats-aside__stat-block stat-block buildings-widget">
    <div class="stat-block__header">
        <h4 class="stat-block__title flex items-center gap-x-14">
            {{ t('common', 'Базы игрока') }}
            <span
                    class="icons icons_24px icons_24px_info cursor-pointer stat-block__info"
                    data-bs-toggle="tooltip"
                    data-bs-title="{{ t('common', 'В этом блоке отображаются строения игрока в котором он проживал.') }}"
            ></span>
        </h4>
    </div>

    <div class="buildings-list">
        {% for ITEM in ITEMS %}
        <a href="{{ ITEM.URL }}" class="building-card">
            <div class="building-card__image-wrapper">
                <img
                        src="{{ ITEM.IMAGE }}"
                        alt="{{ ITEM.NAME }}"
                        class="building-card__image"
                        loading="lazy"
                />
                <div class="building-card__overlay">
                    <span class="building-card__view-icon">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
            </div>

            <div class="building-card__content">
                <h5 class="building-card__title">{{ ITEM.NAME }}</h5>
                <time datetime="{{ ITEM.DATE }}" class="building-card__date">
                    <i class="far fa-calendar"></i>
                    {{ ITEM.DATE }}
                </time>
            </div>
        </a>
        {% endfor %}
    </div>

    <a href="/buildings/create" class="button button-primary w-full buildings-widget__add-button">
        <span class="button__text">
            <i class="fas fa-plus-circle"></i>
            {{ t('common', 'Добавить постройку') }}
        </span>
    </a>
</section>