<div class="grid gap-y-24 px-24 pb-24">
    <div class="relative">
        <div class="servers_page_item_wipes">
            <div class="servers_page_item_wipes_wipe">
                <span class="servers_page_item_wipes_wipe_label">{{ t('common', 'Последний вайп') }}</span>
                <span class="servers_page_item_wipes_wipe_date">
                    <span class="wipe_timer" data-time="{{ SERVER.wipeTime() }}">{{ SERVER.wipe|date('d.m.Y H:i') }} МСК</span>
                </span>
            </div>
            <div class="servers_page_item_wipes_wipe">
                <span class="servers_page_item_wipes_wipe_label">{{ t('common', 'Следующий вайп') }}</span>
                <span class="servers_page_item_wipes_wipe_date">
                    <span class="wipe_timer" data-time="{{ SERVER.nextWipeTime() }}">{{ SERVER.next_wipe|date('d.m.Y H:i') }} МСК</span>
                </span>
            </div>
            <div class="servers_page_item_wipes_wipe">
                <span class="servers_page_item_wipes_wipe_label">{{ t('common', 'Глобальный вайп') }}</span>
                <span class="servers_page_item_wipes_wipe_date">
                    <span class="wipe_timer" data-time="{{ SERVER.globalWipeTime() }}">{{ SERVER.global_wipe|date('d.m.Y H:i') }} МСК</span>
                </span>
            </div>
        </div>
    </div>
</div>