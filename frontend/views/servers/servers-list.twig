{{ use('lo/widgets/magnific/MagnificPopup') }}
<div class="servers_page">
    <div class="page-stats__block-without-hover">
        <div class="relative">
            <h2 class="flex items-center gap-x-12 pb-24">{{ t('common', 'Наши сервера') }}</h2>
            <img class="servers_page_image" src="{{ SETTINGS.get('design_servers_image') }}">
        </div>
        <div class="servers_page_items">
            {% for SERVER in SERVERS %}
                <article class="servers_page_item_wrap server_status{{ SERVER.status }}" data-server-id="{{ SERVER.id }}">
                    <div class="servers_page_item">
                        <header class="servers_page_item_header">
                            <h5 class="servers_page_item_header_title">{{ t('database', SERVER.monitoring_description) }} [{{ t('database', SERVER.monitoring_name) }}]</h5>
                            <span class="servers_page_item_header_status">{{ SERVER.wipeTypeText() }}</span>
                            <div class="servers_page_item_header_content">
                                <div class="servers_page_item_progress__wrap">
                                    <div class="servers_page_item_progress progress_js" style="width: {{ SERVER.monitoring().percentPlayers + SERVER.monitoring().percentJoined }}%;">
                                        <div class="servers_page_item_progress_players players_progress_js" style="width: {{ SERVER.monitoring().percentPlayersAbsolute + SERVER.monitoring().percentJoinedAbsolute }}%;"></div>
                                    </div>
                                </div>
                                <span class="servers_page_item_progress-value"><span class="players_js">{{ SERVER.players + SERVER.joined }}</span>/{{ SERVER.max }}</span>
                            </div>
                        </header>
                        <div class="servers_page_item_actions">
                            <div class="servers_page_item_ip btn-clipboard"
                                 data-clipboard-text="connect {{ SERVER.ip }}:{{ SERVER.port }}"
                                 data-message="{{ t('common', 'IP адрес скопирован в буфер обмена!') }}"
                                 data-bs-toggle="tooltip"
                                 data-bs-title="{{ t('common', 'Скопировать IP') }}">
                                <span class="servers_page_item_ip_content">connect {{ SERVER.ip }}:{{ SERVER.port }}</span>
                            </div>
                            <div class="servers_page_item_actions_r">
                                <a class="button button-secondary show-modal-link"
                                   href="{{ SERVER.getLink('wipe-info') }}"
                                   data-size="modal-sm"
                                   data-toggl="modal"
                                   data-target="modal-dialog"
                                   data-title="{{ t('common', 'Когда вайп') }}">{{ t('common', 'Когда вайп') }}</a>
{#                                <a class="button button-secondary" href="{{ SERVER.getLink('map') }}" target="_blank" >{{ t('common', 'О сервере') }}</a>#}
{#                                {% if SERVER.map_id %}#}
{#                                    <a class="button button-secondary servers_page_item_actions_r_image" href="{{ SERVER.mapEntity.getImage() }}" title="{{ SERVER.mapEntity.size }}_{{ SERVER.mapEntity.seed }}" target="_blank" >#}
{#                                        {{ t('common', 'Текущая карта') }}<img style="width: 1px; height: 1px; opacity: 0;" src="{{ SERVER.mapEntity.getPreviewImage() }}" alt="{{ SERVER.mapEntity.size }}_{{ SERVER.mapEntity.seed }}">#}
{#                                    </a>#}
{#                                {% endif %}#}
                                <a class="button button-secondary" href="{{ SERVER.getLink('rules') }}">{{ t('common', 'Правила сервера') }}</a>
                                <a class="button button-secondary" href="{{ SERVER.getLink('stats') }}">{{ t('common', 'Статистика') }}</a>
                            </div>
                        </div>
                        {#                    <div class="servers_page_item_labels">#}
                        {#                        {% if not SERVER.is_store %}#}
                        {#                            <div class="servers_page_item_labels_label"><i class="fas fa-check"></i> {{ t('common', 'Донат выключен') }}</div>#}
                        {#                        {% endif %}#}
                        {#                        {% if SERVER.stats_payment %}#}
                        {#                            <div class="servers_page_item_labels_label"><i class="fas fa-wallet"></i> {{ t('common', 'Оплата за топы') }}</div>#}
                        {#                        {% endif %}#}
                        {#                        {% if SERVER.skindrops %}#}
                        {#                            <div class="servers_page_item_labels_label"><i class="fas fa-gift"></i> {{ t('common', 'Раздача скинов') }}</div>#}
                        {#                        {% endif %}#}
                        {#                        {% if SERVER.team_limit %}#}
                        {#                            <div class="servers_page_item_labels_label"><i class="fas fa-users"></i> {{ t('common', 'Лимит {PARAM_LIMIT} человека', {PARAM_LIMIT: SERVER.team_limit}) }}</div>#}
                        {#                        {% else %}#}
                        {#                            <div class="servers_page_item_labels_label"><i class="fas fa-users-slash"></i> {{ t('common', 'Лимит не ограничен') }}</div>#}
                        {#                        {% endif %}#}
                        {#                        <div class="servers_page_item_labels_label"><i class="fas fa-bell"></i> {{ t('common', 'Оповещение о рейдах') }}</div>#}
                        {#                    </div>#}
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</div>
{{
magnific_popup_widget({
    'target': '.servers_page',
    'options': {
        'delegate': '.servers_page_item_actions_r_image',
        'gallery': {
            'enabled': false
        },
    },
    'effect': 'with-zoom'
})
}}