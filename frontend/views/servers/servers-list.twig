{{ use('lo/widgets/magnific/MagnificPopup') }}
<div class="servers_page">
    <div class="page-stats__block-without-hover">
        <div class="relative">
            <h1 class="h2 text-center">{{ t('common', 'Сервера Rust для комфортной игры') }}</h1>
            <div class="seo-content pb-24">
                <p class="mt-24 text-center p1 text-text-teritiary">{{ t('common', 'На нашем проекте работают несколько серверов Rust с разными параметрами') }}:</p>
                <ul class="servers_page_description_list mt-24">
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/locations.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Физическое расположение в Москве (пинг 30-70 мс для СНГ)') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/calendar.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Регулярные вайпы строго по расписанию') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/admin.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Защита от читеров с активной модерацией') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/training.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Поддержка разных игровых режимов') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/gift.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Раздача скинов каждый час') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/check.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'В рыбацких деревнях, ранчо, амбарах: переработчики, станции дронов и НПЗ') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/chart-line.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Сервера с онлайн 1000+ игроков') }}</span>
                    </li>
                    <li class="servers_page_description_list_item">
                        <span class="servers_page_description_list_item_image"><img src="/images/design/icons/32px/procesor.svg"/></span>
                        <span class="servers_page_description_list_item_text">{{ t('common', 'Мощное железо I9 14900k на сервере') }}</span>
                    </li>
                </ul>
                <p class="mt-24 text-center p1 text-text-teritiary">{{ t('common', 'Вы можете выбрать любой из доступных серверов в зависимости от предпочитаемого режима игры') }}.</p>
            </div>
            {#            <img class="servers_page_image" src="{{ SETTINGS.get('design_servers_image') }}">#}
        </div>
        <div class="servers_page_items">
            {% for SERVER in SERVERS %}
                <article class="servers_page_item_wrap server_status{{ SERVER.status }}" data-server-id="{{ SERVER.id }}">
                    <div class="servers_page_item">
                        <header class="servers_page_item_header">
                            <h5 class="servers_page_item_header_title">{{ t('database', SERVER.monitoring_description) }} [{{ t('database', SERVER.monitoring_name) }}]</h5>
                            {% if SERVER.serversTags %}
                                <div class="server_info_serversTags">
                                    {% for TAG in SERVER.serversTags %}
                                        <a href="{{ TAG.getLink() }}">
                                            <span class="servers_page_item_header_status" style="background-color: {{ TAG.color }}">{{ t('database', TAG.name) }}</span>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if SERVER.team_limit > 0 %}
                                <span class="servers_page_item_header_status"><i class="fas fa-users"></i> {{ t('common', 'Лимит') }} {{ SERVER.team_limit }} {{ t('common', 'человека') }}</span>
                            {% endif %}
                            {% if SERVER.status == 1 %}
                                <span class="servers_page_item_header_status"><span class="text-online"><i class="fas fa-user"></i> {{ SERVER.players + SERVER.joined }}</span>/{{ SERVER.max }}</span>
                            {% elseif SERVER.status == 0 %}
                                <span class="servers_page_item_header_status text-online">{{ t('common', 'Идет перезагрузка') }}</span>
                            {% endif %}
                        </header>
                        <div class="servers_page_item_actions">
                            <div class="servers_page_item_ip btn-clipboard"
                                 data-clipboard-text="connect {{ SERVER.ip }}:{{ SERVER.port }}"
                                 data-message="{{ t('common', 'IP адрес скопирован в буфер обмена!') }}"
                                 data-bs-toggle="tooltip"
                                 data-bs-title="{{ t('common', 'Скопировать IP') }}">
                                <span class="servers_page_item_ip_content">connect {{ SERVER.ip }}:{{ SERVER.port }}</span>
                            </div>
                            <div class="servers_page_item_actions_r">
                                {% if SERVER.status == 1 %}
                                    <a class="button button-primary" href="steam://rungameid/252490//+connect {{ SERVER.ip }}:{{ SERVER.port }}"><span class="button__text">{{ t('common', 'Подключиться к серверу') }}</span></a>
                                {% endif %}
                                <a class="button button-secondary show-modal-link"
                                   href="{{ SERVER.getLink('wipe-info') }}"
                                   rel="nofollow"
                                   data-size="modal-sm"
                                   data-toggl="modal"
                                   data-target="modal-dialog"
                                   data-title="{{ t('common', 'Когда вайп') }}">{{ t('common', 'Когда вайп') }}</a>
                                {% if SERVER.map_list_id and SERVER.mapList and not SERVER.secret_map %}
                                    <a class="button button-secondary servers_page_item_actions_r_image show-modal-link"
                                       href="/maps-v2/detail/{{ SERVER.map_list_id }}?server_id={{ SERVER.id }}"
                                       data-href="/maps-v2/detail/{{ SERVER.map_list_id }}?server_id={{ SERVER.id }}"
                                       data-target="modal-dialog"
                                       data-size="modal-xxl"
                                       data-title="{{ t('common', 'Текущая карта') }}"
                                       data-content-overflow="unset"
                                       title="{{ t('common', 'Текущая карта') }}">
                                        {{ t('common', 'Текущая карта') }}
                                        {% if SERVER.mapList.image_preview %}
                                            <img src="{{ SERVER.mapList.image_preview }}" loading="lazy" alt="{{ SERVER.mapList.hash }}">
                                        {% elseif SERVER.mapList.image %}
                                            <img src="{{ SERVER.mapList.image }}" loading="lazy" alt="{{ SERVER.mapList.hash }}">
                                        {% endif %}
                                    </a>
                                {% endif %}
                                <a class="button button-secondary" href="{{ SERVER.getLink('rules') }}">{{ t('common', 'Правила сервера') }}</a>
                                <a class="button button-secondary" href="{{ SERVER.getLink('stats') }}">{{ t('common', 'Статистика') }}</a>
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
        {# === SEO БЛОК: вводный текст + преимущества + перелинковка === #}
        <section class="seo-block mt-32">
            <h2 class="h3 text-left">{{ t('common','Rust сервера Prostoj — как выбрать подходящий') }}</h2>
            <p class="mt-16 p1 text-text-secondary">
                {{ t('common','На проекте Prostoj доступны классические и ускоренные режимы с разной сложностью, онлайном и расписанием вайпов. Выбирайте сервер по пингу, размеру карты и лимиту команды — подключение в один клик из браузера. Все сервера хостятся на мощном железе и проходят регулярные перезагрузки для стабильного FPS и низкого пинга.') }}
            </p>

            <ul class="mt-16 servers_page_description_list">
                <li class="servers_page_description_list_item">{{ t('common','Чёткий график вайпов: недельные и 14-дневные') }}</li>
                <li class="servers_page_description_list_item">{{ t('common','Античит + активная модерация') }}</li>
                <li class="servers_page_description_list_item">{{ t('common','Карты под разные стили игры: соло, дуо, отряды') }}</li>
                <li class="servers_page_description_list_item">{{ t('common','Подарки и ивенты для игроков') }}</li>
            </ul>

            {# Внутренняя перелинковка — усиливает индексацию ключевых страниц #}
            <div class="mt-20 flex flex-wrap gap-8 justify-left">
                <a class="button button-secondary mr-6" href="/wipe-calendar">{{ t('common','Календарь вайпов Rust') }}</a>
                <a class="button button-secondary mr-6" href="/raid-table">{{ t('common','Калькулятор рейда') }}</a>
                <a class="button button-secondary mr-6" href="/posts">{{ t('common','Гайды и новости Rust') }}</a>
                <a class="button button-secondary" href="/custom-skins">{{ t('common','Кастомные скины сообщества') }}</a>
            </div>
        </section>

        {# === SEO FAQ (UX + rich snippet) === #}
        <section class="seo-faq mt-32">
            <h2 class="h3 text-left">{{ t('common','Частые вопросы о серверах Prostoj') }}</h2>

            <div class="mt-16 max-w-3xl mx-auto">
                <details class="faq-item">
                    <summary class="p1"><strong>{{ t('common','Когда следующий вайп на сервере?') }}</strong></summary>
                    <div class="p2 mt-8">
                        {{ t('common','Недельные сервера вайпаются каждую неделю, 14-дневные — раз в 2 недели. После глобального вайпа в первый четверг месяца дополнительных вайпов в эту неделю нет. Актуальные даты смотрите в ') }}
                        <a href="/wipe-calendar">{{ t('common','календаре вайпов') }}</a>.
                    </div>
                </details>

                <details class="faq-item mt-12">
                    <summary class="p1"><strong>{{ t('common','Как быстро подключиться к серверу?') }}</strong></summary>
                    <div class="p2 mt-8">
                        {{ t('common','Нажмите «Подключиться к серверу» в карточке — откроется Steam с прямым подключением. Либо скопируйте команду вида ') }}
                        <code>connect IP:PORT</code> {{ t('common',' и вставьте в консоль Rust.') }}
                    </div>
                </details>

                <details class="faq-item mt-12">
                    <summary class="p1"><strong>{{ t('common','Какой сервер выбрать новичку?') }}</strong></summary>
                    <div class="p2 mt-8">
                        {{ t('common','Рекомендуем начать с карт малого/среднего размера и серверов с лимитом команды. Так легче освоиться и найти союзников.') }}
                    </div>
                </details>

                <details class="faq-item mt-12">
                    <summary class="p1"><strong>{{ t('common','Разрешены ли моды и донат?') }}</strong></summary>
                    <div class="p2 mt-8">
                        {{ t('common','Игровой баланс не ломаем: на серверах действуют общие правила, донат отключён там, где это указано на карточке. За нарушения — санкции по правилам.') }}
                    </div>
                </details>
            </div>
        </section>
    </div>
</div>
{% if this.params.ld_json is defined %}
    <script type="application/ld+json">
{{ this.params.ld_json|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}
</script>
{% endif %}

{% set faq_list = [
    {
        "@type": "Question",
        "name": "Когда следующий вайп на сервере?",
        "acceptedAnswer": {
        "@type": "Answer",
        "text": "Недельные сервера вайпаются каждую неделю, 14-дневные — раз в 2 недели. После глобального вайпа в первый четверг месяца дополнительных вайпов в эту неделю нет. Актуальные даты — в /wipe-calendar."
    }
    },
    {
        "@type": "Question",
        "name": "Как быстро подключиться к серверу?",
        "acceptedAnswer": {
        "@type": "Answer",
        "text": "Нажмите «Подключиться к серверу» в карточке сервера — запустится Steam с прямым подключением. Либо используйте команду connect IP:PORT в консоли Rust."
    }
    },
    {
        "@type": "Question",
        "name": "Какой сервер выбрать новичку?",
        "acceptedAnswer": {
        "@type": "Answer",
        "text": "Для старта подойдут карты малого/среднего размера и сервера с лимитом команды — так проще освоиться и найти напарников."
    }
    },
    {
        "@type": "Question",
        "name": "Разрешены ли моды и донат?",
        "acceptedAnswer": {
        "@type": "Answer",
        "text": "Баланс не ломаем: действуют общие правила, донат отключён там, где это указано. За нарушения применяются санкции по правилам сервера."
    }
    }
] %}

<script type="application/ld+json">
{{ {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faq_list
    } | json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) | raw }}
</script>